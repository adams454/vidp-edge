REGISTRY={{ vidp_registry | default('vidp') }}
TAG={{ vidp_tag | default('latest') }}
CLOUD_URL=https://{{ cloud_ip }}:8443
CLOUD_CA=/certs/ca.pem
CLOUD_PUBLIC_URL=http://{{ cloud_ip }}
CLOUD_PROM_URL=http://{{ cloud_ip }}:{{ 9091 if cloud_colocated | default(false) | bool else 9090 }}
NODE_ID={{ node_id }}
MODE={{ vidp_mode | default('hybrid') }}
