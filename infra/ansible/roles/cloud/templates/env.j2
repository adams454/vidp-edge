REGISTRY={{ vidp_registry | default('vidp') }}
TAG={{ vidp_tag | default('latest') }}
CLOUD_MASTER_SECRET={{ cloud_master_secret }}
DATA_DIR=/data
STORAGE={{ storage | default('local') }}
S3_BUCKET={{ s3_bucket | default('') }}
DDB_TABLE={{ ddb_table | default('') }}
AWS_REGION={{ aws_region | default('eu-west-3') }}
CLOUD_PROM_PORT={{ cloud_prom_port | default(9091 if cloud_colocated | default(false) | bool else 9090) }}
