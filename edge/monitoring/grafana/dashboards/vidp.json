{
 "uid": "vidp-edge",
 "title": "VidP — pipeline, WAN, SLO, énergie",
 "schemaVersion": 39,
 "version": 2,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Latence arrivée → résultat publié (Cloud)",
   "datasource": {
    "type": "prometheus",
    "uid": "cloud"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(cloud_publish_latency_seconds_bucket[2m])))",
     "legendFormat": "p50",
     "datasource": {
      "type": "prometheus",
      "uid": "cloud"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(cloud_publish_latency_seconds_bucket[2m])))",
     "legendFormat": "p95",
     "datasource": {
      "type": "prometheus",
      "uid": "cloud"
     }
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(cloud_publish_latency_seconds_bucket[2m])))",
     "legendFormat": "p99",
     "datasource": {
      "type": "prometheus",
      "uid": "cloud"
     }
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
