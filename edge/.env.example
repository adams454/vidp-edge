# --- Généré automatiquement par Ansible (edge/.env, 0600). Exemple pour un essai manuel. ---
REGISTRY=vidp
TAG=latest
CLOUD_URL=https://CLOUD_IP:8443
CLOUD_CA=/certs/ca.pem
CLOUD_PUBLIC_URL=http://CLOUD_IP
CLOUD_PROM_URL=http://CLOUD_IP:9090
NODE_ID=edge-01
MODE=hybrid
RUN_ID=demo
FEED_RATE=4
DURATION_S=0
T_BUDGET_S=20
SPOOL_QUOTA_MB=1024
GRAFANA_PASSWORD=__généré__
# Le jeton d'identité du nœud est dans edge/.env.secret (NODE_TOKEN=...), lu par le seul téléverseur.
