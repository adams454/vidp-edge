# Généré par Ansible (cloud/.env, 0600 ; jamais dans l'image ni dans Git)
REGISTRY=vidp
TAG=latest
CLOUD_MASTER_SECRET=__généré__
DATA_DIR=/data
# local = SQLite + disque (« BD simple ») ; aws = S3 + DynamoDB (rôle IAM de l'instance)
STORAGE=local
S3_BUCKET=
DDB_TABLE=
AWS_REGION=eu-west-3
CLOUD_PROM_PORT=9090
# Test de STORAGE=aws sans compte AWS : docker compose --profile awslocal up -d, puis
# STORAGE=aws S3_BUCKET=vidp DDB_TABLE=vidp S3_ENDPOINT=http://minio:9000 DDB_ENDPOINT=http://dynamodb:8000
# AWS_ACCESS_KEY_ID=vidplocal AWS_SECRET_ACCESS_KEY=vidplocal-secret
